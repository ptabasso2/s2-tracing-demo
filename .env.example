# Copy to .env and adjust.

# SingleStore root password (admin only; the app uses the 'app' user from init.sql)
S2_ROOT_PASSWORD=rootpass

# Datadog (required only for: docker compose --profile datadog up)
DD_API_KEY=
DD_SITE=datadoghq.com
DD_ENV=local

# Tracer troubleshooting: logs which classes the agent instruments
DD_TRACE_DEBUG=false

# --- Baseline run (SingleStore driver WITHOUT opt-in) ------------------------
# Uncomment both lines to see what the trace looks like with no JDBC opt-in:
#DD_TRACE_JDBC_CONNECTION_CLASS_NAME=
#DD_TRACE_JDBC_PREPARED_STATEMENT_CLASS_NAME=

# --- Comparison run: MariaDB Connector/J (on the tracer allow-list) ----------
#DB_URL=jdbc:mariadb://singlestore:3306/demo
#DB_DRIVER=org.mariadb.jdbc.Driver
